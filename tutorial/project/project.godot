config_version=5

[application]
config/name="Star Catcher — gdzig tutorial"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=640
window/size/viewport_height=480

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.09, 1)

[input]
left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":65)]}
right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":68)]}
up={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":87)]}
down={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":83)]}
restart={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":82)]}
